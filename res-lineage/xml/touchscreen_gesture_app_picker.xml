<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="touchscreen_gesture_app_picker"
    android:title="@string/touchscreen_gesture_app_picker_title">

    <!-- Room under a two-line collapsing toolbar title. -->
    <com.android.settings.applications.SpacePreference
        android:key="touchscreen_gesture_app_picker_space"
        android:layout_height="24dp"
        android:selectable="false" />

    <com.android.settingslib.widget.TopIntroPreference
        android:key="touchscreen_gesture_app_picker_intro"
        android:title="@string/touchscreen_gesture_app_picker_summary" />

    <PreferenceCategory
        android:key="touchscreen_gesture_app_list"
        android:title="@string/touchscreen_gesture_app_list_title" />

</PreferenceScreen>
